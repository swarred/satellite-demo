# Build outputs — never commit disk images or archives
output/
*.qcow2
*.tar

# Python
__pycache__/
*.pyc
*.pyo

# Developer session notes — environment-specific, not user-facing docs
BUILD-LOG.md

# Staged build artefacts — copied here by automation before image build, never committed
build/

# Generated by automation from templates — contain the local registry IP, never commit
containers/local-registry.conf
eda/bootc-switch-offline.yml
eda/bootc-switch-online.yml

# Generated by automation at build time — contains private enrollment key, cluster-specific
flightctl/config.yaml
flightctl/ca.crt
flightctl/client-enrollment.crt
client-enrollment.key
